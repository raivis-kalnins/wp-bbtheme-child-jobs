{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "880px", "wideSize": "1280px" },
    "color": {
      "palette": [
        { "slug": "jobs-ink", "name": "Jobs Ink", "color": "#0b1739" },
        { "slug": "jobs-brand", "name": "Jobs Brand", "color": "#3155d9" },
        { "slug": "jobs-accent", "name": "Jobs Accent", "color": "#19a7ce" },
        { "slug": "jobs-surface", "name": "Jobs Surface", "color": "#f6f8fc" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"] },
    "typography": { "fluid": false }
  },
  "styles": {
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": { "typography": { "fontWeight": "750", "lineHeight": "1.1" } },
      "link": { "color": { "text": "#3155d9" } }
    }
  }
}
