{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "jobs-ink",
          "name": "Jobs Ink",
          "color": "#10254c"
        },
        {
          "slug": "jobs-brand",
          "name": "Jobs Brand",
          "color": "#078f6a"
        },
        {
          "slug": "jobs-accent",
          "name": "Jobs Accent",
          "color": "#0caf80"
        },
        {
          "slug": "jobs-mint",
          "name": "Jobs Mint",
          "color": "#eef8f5"
        },
        {
          "slug": "jobs-surface",
          "name": "Jobs Surface",
          "color": "#f7fbfa"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    },
    "typography": {
      "fluid": false
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "750",
          "lineHeight": "1.1"
        }
      },
      "link": {
        "color": {
          "text": "#08765c"
        }
      }
    }
  }
}
